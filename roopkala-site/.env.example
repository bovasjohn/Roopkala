# Copy to .env for local work. On Cloudflare, add the same names under
# Settings -> Variables and Secrets, for BOTH the build and the runtime.
#
# Everything here is PUBLIC (it is baked into the site). Use only the anon key.
# NEVER put the service_role key, payment secrets or webhook secrets in this file.

PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Your live address, no trailing slash. Used for canonical links, sitemap and share previews.
PUBLIC_SITE_URL=https://www.example.com
