{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": []
  },
  "include": ["src/lib/**/*.ts", "src/scripts/**/*.ts", "src/pages/**/*.ts", "tests/**/*.ts", "check/shim-check.d.ts"]
}
